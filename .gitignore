release_downloads/

# Raw ECG records are distributed as release assets, not Git objects.
data/external_dev/rhythm/*
!data/external_dev/rhythm/README.md
!data/external_dev/rhythm/*.json
!data/external_dev/rhythm/*.csv
data/external_dev/pathology/*
!data/external_dev/pathology/README.md
!data/external_dev/pathology/*.json
!data/external_dev/pathology/*.csv
data/external_dev/extracted/
*.dat
*.mat
*.hea
*.npy
*.npz
*.tar
*.tar.gz
*.tar.zst

